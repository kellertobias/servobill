NOT_SERVERLESS=true

HOSTED_ZONE_DOMAIN_NAME="<Hosted-Zone-Domain-Name>"
SITE_DOMAIN="<App Domain>"

# Authentication relevant config (see docs/authentication.md):
JWT_SECRET="<generate a random secret here>"
# Emails that may sign in with Google/OIDC the first time; ADMIN_EMAILS are always admins
ALLOWED_EMAILS="<allowed sso account email>"
# ADMIN_EMAILS="<admin email>"

# Google sign in
OAUTH_CLIENT_ID="<get this from google developer console>"

# Local users (email + password)
# LOCAL_AUTH_ENABLED="true"
# INITIAL_ADMIN_EMAIL="admin@example.com"
# INITIAL_ADMIN_PASSWORD="<at least 10 characters, remove after first sign in>"

# OpenID Connect providers, e.g. Zitadel
# OIDC_PROVIDERS="zitadel"
# OIDC_ZITADEL_NAME="Zitadel"
# OIDC_ZITADEL_ISSUER="https://auth.example.com"
# OIDC_ZITADEL_CLIENT_ID="<client id>"
# OIDC_ZITADEL_CLIENT_SECRET="<client secret, empty for PKCE clients>"
# OIDC_ZITADEL_SCOPES="openid email profile urn:zitadel:iam:org:project:roles"
# OIDC_ZITADEL_ROLES_CLAIM="urn:zitadel:iam:org:project:roles"
# OIDC_ZITADEL_ADMIN_ROLES="servobill-admin"
# OIDC_ZITADEL_AUTO_PROVISION="false"

####################
# Relational Database Configuration
# Only enable if you know how to host postgres
####################
# POSTGRES_URL="postgres://servobill:servobill@localhost:5432/servobill"

####################
# EMAIL Configuration
# Either enable SES or SMTP (defaults to SES)
####################

# # SMTP:
# SMTP_HOST="smtp.mailer.de"
# SMTP_PORT="587"
# SMTP_USER="user"
# SMTP_PASS="pass"
# SMTP_FROM="me@mailer.de"
# SMTP_FROM_NAME="Company"

# # SES - enable this if you want to use different AWS credentials for email.
# SES_ACCESS_KEY_ID="..."
# SES_SECRET_ACCESS_KEY="..."

####################
# File Storage Configuration
# Either enable S3 or Local
####################

# Local
# UPLOAD_DIRECTORY="./data"

# S3
BUCKET_FILES="<file bucket name>"

####################
# AI Setup
# We currently only have tested openai
####################
# AI Setup
LLM_PROVIDER="openai"
LLM_API_KEY="<open-ai-key>"

# Deployment relevant config for serverless deployments with SST:
USE_AWS_PROFILE="<the profile name of your aws cli profile - if you have multiple setup>"
DNS_ZONE="<aws route 53 zone id>"

# Deployment of SES - only enable one
EMAIL_SENDER="yourdomain.de" # if you want to create an SES sender identity
EMAIL_SENDER_IDENTITY="yourdomain.de" # if you want to use an existing one
# GraphQL introspection exposes the full API schema. It is off outside of
# development unless enabled here.
# GRAPHQL_INTROSPECTION=true
