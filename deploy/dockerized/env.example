# Example environment file for Servobill Docker Compose Release
# Copy to .env and adjust values as needed

# SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your@email.com
SMTP_FROM_NAME=Servobill

# App configuration
INSECURE_COOKIES=false
JWT_SECRET=your-jwt-secret

# Authentication, see docs/authentication.md
ALLOWED_EMAILS=user1@email.com,user2@email.com
ADMIN_EMAILS=
# Google sign in (optional)
OAUTH_CLIENT_ID=
# Local users (optional)
LOCAL_AUTH_ENABLED=true
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-please
# OpenID Connect, e.g. Zitadel (optional)
OIDC_PROVIDERS=
# OIDC_ZITADEL_NAME=Zitadel
# OIDC_ZITADEL_ISSUER=https://auth.example.com
# OIDC_ZITADEL_CLIENT_ID=
# OIDC_ZITADEL_CLIENT_SECRET=
# OIDC_ZITADEL_SCOPES=openid email profile urn:zitadel:iam:org:project:roles
# OIDC_ZITADEL_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
# OIDC_ZITADEL_ADMIN_ROLES=servobill-admin
NEXT_PUBLIC_API_URL=https://your-servobill-domain.com/
PORT=3000 