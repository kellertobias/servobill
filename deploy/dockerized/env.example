# Servobill self-hosted configuration (Docker Compose).
# Copy to .env next to docker-compose.yml and adjust the values.
# All variables are also documented in docs/self-hosting.md.

# --- Required ----------------------------------------------------------------
# Password of the bundled Postgres database
DB_PASSWORD=change-me
# Random secret for session cookies, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# Optional: use a SQLite file instead of the bundled Postgres (single host
# only, see docs/self-hosting.md). DB_PASSWORD is then unused but required.
# SQLITE_PATH=/data/servobill.sqlite

# --- Web ---------------------------------------------------------------------
# Host port of the web app
HTTP_PORT=3000
# Public URL of the app. Needed for sign in redirects when the app is not
# reached through a TLS reverse proxy that sets X-Forwarded-Proto.
PUBLIC_URL=https://billing.example.com
# Set to true only when the app is served over plain http (no TLS)
INSECURE_COOKIES=false

# --- Images & data -----------------------------------------------------------
# SERVOBILL_VERSION=v1
# Named volume or host path for uploads, PDFs and the event queue.
# Host paths must be writable by uid 1000 (`chown -R 1000:1000 ./data`).
# DATA_VOLUME=./data

# --- File storage ------------------------------------------------------------
# Default: files are stored in the data volume. For S3 or MinIO clear
# UPLOAD_DIRECTORY and configure the bucket:
# UPLOAD_DIRECTORY=
# BUCKET_FILES=servobill
# ENDPOINT_S3=http://minio:9000
# S3_PUBLIC_ENDPOINT=https://s3.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1

# --- Email (SMTP) ------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=billing@example.com
SMTP_FROM_NAME=Servobill

# --- Authentication (see docs/authentication.md) -----------------------------
ALLOWED_EMAILS=
ADMIN_EMAILS=
# Local users
LOCAL_AUTH_ENABLED=true
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-please
# Google sign in (optional)
OAUTH_CLIENT_ID=
# OpenID Connect, e.g. Zitadel (optional)
OIDC_PROVIDERS=
# OIDC_ZITADEL_NAME=Zitadel
# OIDC_ZITADEL_ISSUER=https://auth.example.com
# OIDC_ZITADEL_CLIENT_ID=
# OIDC_ZITADEL_CLIENT_SECRET=
# OIDC_ZITADEL_SCOPES=openid email profile urn:zitadel:iam:org:project:roles
# OIDC_ZITADEL_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
# OIDC_ZITADEL_ADMIN_ROLES=servobill-admin

# --- AI receipt import (optional) --------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=
