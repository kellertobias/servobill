# Copy to secrets.env (git-ignored) and fill in.
JWT_SECRET=
DB_PASSWORD=
# Must match DB_PASSWORD when using components/postgres
POSTGRES_URL=postgres://servobill:<DB_PASSWORD>@servobill-postgres:5432/servobill
# MinIO root credentials (components/minio) or your S3 credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_USER=
SMTP_PASSWORD=
# Remove after the first sign in, see docs/authentication.md
INITIAL_ADMIN_PASSWORD=
# OIDC_ZITADEL_CLIENT_SECRET=
# OAUTH_CLIENT_ID=
# LLM_API_KEY=
