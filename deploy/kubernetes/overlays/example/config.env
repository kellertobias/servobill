# Non-secret configuration, see docs/self-hosting.md and docs/authentication.md
PUBLIC_URL=https://billing.example.com
NOT_SERVERLESS=true

# File storage in MinIO (components/minio)
BUCKET_FILES=servobill
ENDPOINT_S3=http://servobill-minio:9000
S3_PUBLIC_ENDPOINT=https://s3.billing.example.com
AWS_REGION=eu-central-1

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=billing@example.com
SMTP_FROM_NAME=Servobill

# Authentication
LOCAL_AUTH_ENABLED=true
INITIAL_ADMIN_EMAIL=admin@example.com
ALLOWED_EMAILS=
ADMIN_EMAILS=
OIDC_PROVIDERS=
# OIDC_ZITADEL_NAME=Zitadel
# OIDC_ZITADEL_ISSUER=https://auth.example.com
# OIDC_ZITADEL_CLIENT_ID=
# OIDC_ZITADEL_SCOPES=openid email profile urn:zitadel:iam:org:project:roles
# OIDC_ZITADEL_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
# OIDC_ZITADEL_ADMIN_ROLES=servobill-admin
